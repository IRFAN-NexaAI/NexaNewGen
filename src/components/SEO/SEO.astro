---
// SEO head tags: title, description, canonical, OG, Twitter, JSON-LD.
export interface Props { title: string; description: string; path?: string; type?: string }
const { title, description, path = '/', type = 'website' } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://irfan-nexanewgen.pages.dev';
const url = site + path;
const crumbs = path.split('/').filter(Boolean);
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content="IRFAN – NEXA NEWGEN" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "IRFAN – NEXA NEWGEN",
  "url": site,
  "slogan": "ENTER THE FUTURE. EXPLORE THE IMPOSSIBLE.",
  "founder": { "@type": "Person", "name": "Irfan" }
})} />
{crumbs.length > 0 && (
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": site + "/" },
    ...crumbs.map((c, i) => ({ "@type": "ListItem", "position": i + 2, "name": c.replace(/-/g, ' '), "item": site + '/' + crumbs.slice(0, i + 1).join('/') }))]
})} />
)}
<!-- Analytics / Search Console: placeholder only. No keys, no tracking IDs. -->
