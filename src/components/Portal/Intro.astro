---
// Cinematic intro: dark -> particle expands -> portal rings -> brand -> ENTER.
// Shown once per session via sessionStorage. SKIP INTRO always available.
---
<div id="intro" class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-black text-center" role="dialog" aria-label="Cinematic introduction">
  <div class="relative flex h-56 w-56 items-center justify-center">
    <div id="intro-particle" class="h-3 w-3 rounded-full bg-cyan-300 shadow-[0_0_40px_#22d3ee] transition-all duration-1000"></div>
    <div class="portal-ring absolute inset-0 border-cyan-400 animate-spin-slow"></div>
    <div class="portal-ring absolute inset-6 border-violet-400 animate-spin-slow" style="animation-direction:reverse"></div>
    <div class="portal-ring absolute inset-12 border-blue-400 animate-pulse-glow"></div>
  </div>
  <h1 class="grad-text mt-6 px-4 text-3xl font-black tracking-widest sm:text-5xl">IRFAN – NEXA NEWGEN</h1>
  <p class="mt-3 px-4 text-sm tracking-[0.3em] text-cyan-200 sm:text-base">WELCOME TO THE FUTURE OF AI.</p>
  <button id="enter-btn" class="btn-primary mt-8">ENTER THE UNIVERSE →</button>
  <button id="skip-btn" class="mt-4 text-xs tracking-widest text-slate-400 underline">SKIP INTRO</button>
</div>
<script>
  const intro = document.getElementById('intro');
  const seen = sessionStorage.getItem('nexa-intro-seen');
  const close = () => { intro.style.transition = 'opacity .6s, transform .6s'; intro.style.opacity = '0'; intro.style.transform = 'scale(1.15)'; sessionStorage.setItem('nexa-intro-seen', '1'); setTimeout(() => intro.remove(), 650); };
  if (seen) { intro.remove(); }
  else {
    setTimeout(() => { const p = document.getElementById('intro-particle'); if (p) { p.style.transform = 'scale(14)'; p.style.opacity = '0.4'; } }, 400);
    document.getElementById('enter-btn')?.addEventListener('click', close);
    document.getElementById('skip-btn')?.addEventListener('click', close);
  }
</script>
