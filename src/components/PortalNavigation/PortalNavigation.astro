---
import { portals } from '../../data/navigation';
---
<section class="mx-auto max-w-6xl px-4 py-10" aria-label="Portal navigation">
  <h2 class="reveal text-center text-2xl font-black sm:text-3xl">Choose Your <span class="grad-text">Portal</span></h2>
  <p class="mt-2 text-center text-sm text-slate-400">Every category is its own dimension. Step through.</p>
  <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
    {portals.map((p) => (
      <a href={p.href} data-portal class="portal-card glass relative flex flex-col items-center p-5 text-center" style={`color:${p.color}`}>
        <span class="portal-ring" style={`border-color:${p.color}`}></span>
        <span class="text-3xl" aria-hidden="true">◉</span>
        <span class="mt-3 font-bold text-white">{p.label}</span>
        <span class="mt-1 text-xs text-slate-400">{p.blurb}</span>
      </a>
    ))}
  </div>
</section>
<script>
  document.querySelectorAll('[data-portal]').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    a.classList.add('expanding');
    setTimeout(() => { location.href = a.href; }, 550);
  }));
</script>
