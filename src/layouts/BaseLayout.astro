---
import '../styles/global.css';
import SEO from '../components/SEO/SEO.astro';
import Background from '../components/Background/Background.astro';
import Navbar from '../components/Navbar/Navbar.astro';
import Footer from '../components/Footer/Footer.astro';
import ScrollAnimations from '../components/ScrollAnimations/ScrollAnimations.astro';
import Intro from '../components/Portal/Intro.astro';
export interface Props { title: string; description: string; path?: string; theme?: string; showIntro?: boolean }
const { title, description, path = '/', theme = 'hero', showIntro = false } = Astro.props;
const crumbs = path.split('/').filter(Boolean);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#02010a" />
  <SEO title={title} description={description} path={path} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✦</text></svg>" />
</head>
<body data-theme={theme}>
  <Background />
  {showIntro && <Intro />}
  <Navbar />
  <main class="relative z-10 mx-auto max-w-6xl px-4">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="py-4 text-sm text-slate-400">
        <a href="/" class="hover:text-cyan-300">Home</a>
        {crumbs.map((c, i) => (<span> / <a href={'/' + crumbs.slice(0, i + 1).join('/')} class="hover:text-cyan-300">{c.replace(/-/g, ' ')}</a></span>))}
      </nav>
    )}
    <slot />
  </main>
  <Footer />
  <ScrollAnimations />
</body>
</html>
